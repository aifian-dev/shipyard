{
  "name": "shipyard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
