{
  "name": "shipyard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "concurrently --kill-others --names api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "check": "tsc --noEmit && tsc --project ui/tsconfig.json",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "handoff": "node scripts/handoff.mjs",
    "dev:api": "tsx watch src/index.ts",
    "dev:ui": "vite --config vite.config.ts",
    "build": "npm run check && npm run build:ui",
    "build:ui": "vite build --config vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.4",
    "concurrently": "10.0.6"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
