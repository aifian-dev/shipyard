    "handoff": "node scripts/handoff.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "fastify": "5.12.5"
  }
}
